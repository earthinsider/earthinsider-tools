<script id="tool-logic">
/* ==== AI-GENERATED LOGIC — only this function's body is AI content ==== */
function processInput(text) {
if (!text) return "";

// 1. Normalize line endings
let formatted = text.replace(/\r\n/g, "\n");

// 2. Remove trailing spaces on each line
formatted = formatted.split("\n").map(line => line.trimEnd()).join("\n");

// 3. Remove excessive empty lines (max 2 consecutive newlines)
formatted = formatted.replace(/\n{3,}/g, "\n\n");

// 4. Fix double spaces within lines while preserving intentional indentation
formatted = formatted.split("\n").map(line => {
  const match = line.match(/^(\s*)(.*)$/);
  if (match) {
    const indent = match[1];
    const content = match[2].replace(/[ \t]+/g, " ");
    return indent + content;
  }
  return line;
}).join("\n");

// 5. Fix punctuation spacing: ensure space after punctuation but avoid ruining URLs or decimals
formatted = formatted.replace(/([,;:])([^\s\d])/g, "$1 $2");
formatted = formatted.replace(/\s+([.,;:!?])/g, "$1");

// 6. Sentence capitalization: capitalize first letter of sentences
formatted = formatted.replace(/(^\s*|[.!?]\s+)([a-z])/g, (match, separator, letter) => {
  return separator + letter.toUpperCase();
});

return formatted.trim();
}
/* ==== END AI-GENERATED LOGIC ==== */

const toolInput = document.getElementById('toolInput');
const previewContainer = document.getElementById('previewContainer');
function renderOutput(text){
  let out;
  try { out = processInput(text); } catch(e){ out = ''; }
  previewContainer.innerHTML = (out && String(out).trim())
    ? `<div class="preview-item"><div class="preview-text">${String(out).replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div><button class="copy-btn" id="copyBtn">Copy</button></div>`
    : `<div style="text-align:center;padding:20px;color:var(--text-light)">Output will appear here</div>`;
  const copyBtn = document.getElementById('copyBtn');
  if(copyBtn) copyBtn.addEventListener('click', () => navigator.clipboard.writeText(String(out)));
}
document.getElementById('runBtn').addEventListener('click', () => renderOutput(toolInput.value));
document.getElementById('clearBtn').addEventListener('click', () => { toolInput.value=''; renderOutput(''); });
</script>
