<script id="tool-logic">
/* ==== AI-GENERATED LOGIC — only this function's body is AI content ==== */
function generate() {
function getRandomInt(max) {
  if (typeof window !== 'undefined' && window.crypto && window.crypto.getRandomValues) {
    const arr = new Uint32Array(1);
    window.crypto.getRandomValues(arr);
    return arr[0] % max;
  }
  return Math.floor(Math.random() * max);
}

function shuffle(array) {
  for (let i = array.length - 1; i > 0; i--) {
    const j = getRandomInt(i + 1);
    const temp = array[i];
    array[i] = array[j];
    array[j] = temp;
  }
  return array;
}

function generatePassword(length, useSymbols = true) {
  const uppercase = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const lowercase = 'abcdefghijklmnopqrstuvwxyz';
  const numbers = '0123456789';
  const symbols = '!@#$%^&*()_+-=[]{}|;:,.<>?';
  
  let allChars = uppercase + lowercase + numbers;
  if (useSymbols) allChars += symbols;
  
  let password = '';
  password += uppercase[getRandomInt(uppercase.length)];
  password += lowercase[getRandomInt(lowercase.length)];
  password += numbers[getRandomInt(numbers.length)];
  if (useSymbols) password += symbols[getRandomInt(symbols.length)];
  
  while (password.length < length) {
    password += allChars[getRandomInt(allChars.length)];
  }
  
  return shuffle(password.split('')).join('');
}

function generatePassphrase() {
  const wordList = [
    'correct', 'horse', 'battery', 'staple', 'silver', 'forest', 'winter', 'autumn',
    'spring', 'summer', 'garden', 'shadow', 'bridge', 'castle', 'window', 'mirror',
    'clover', 'planet', 'beacon', 'breeze', 'canyon', 'desert', 'harbor', 'island',
    'journey', 'lantern', 'meadow', 'ocean', 'pathway', 'river', 'summit', 'valley',
    'whisper', 'anchor', 'compass', 'feather', 'glacier', 'matrix', 'pebble', 'safari',
    'timber', 'vortex', 'wildlife', 'zenith', 'arcade', 'bubble', 'crater', 'dolphin'
  ];
  const words = [];
  for (let i = 0; i < 4; i++) {
    words.push(wordList[getRandomInt(wordList.length)]);
  }
  return words.join('-');
}

function generatePIN() {
  let pin = '';
  for (let i = 0; i < 6; i++) {
    pin += getRandomInt(10);
  }
  return pin;
}

const pass12 = generatePassword(12);
const pass16 = generatePassword(16);
const pass24 = generatePassword(24);
const passphrase = generatePassphrase();
const pin = generatePIN();

return `🔑 YOUR SECURE GENERATED PASSWORDS 🔑\n\n` +
       `----------------------------------------\n` +
       `⚡ Ultra-Secure (16 characters - Recommended):\n` +
       `${pass16}\n\n` +
       `🛡️ Paranoid Level (24 characters):\n` +
       `${pass24}\n\n` +
       `📱 Standard Secure (12 characters):\n` +
       `${pass12}\n\n` +
       `🗣️ Memorable Passphrase (4 words):\n` +
       `${passphrase}\n\n` +
       `🔢 Secure PIN (6 digits):\n` +
       `${pin}\n` +
       `----------------------------------------\n\n` +
       `💡 Security Tip: Copy your preferred password and save it in a trusted password manager. These passwords are generated locally on your machine and are never transmitted online.`;
}
/* ==== END AI-GENERATED LOGIC ==== */

const previewContainer = document.getElementById('previewContainer');
function renderOutput(){
  let out;
  try { out = generate(); } catch(e){ out = ''; }
  previewContainer.innerHTML = (out && String(out).trim())
    ? `<div class="preview-item"><div class="preview-text">${String(out).replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div><button class="copy-btn" id="copyBtn">Copy</button></div>`
    : `<div style="text-align:center;padding:20px;color:var(--text-light)">Click Generate</div>`;
  const copyBtn = document.getElementById('copyBtn');
  if(copyBtn) copyBtn.addEventListener('click', () => navigator.clipboard.writeText(String(out)));
}
document.getElementById('genBtn').addEventListener('click', renderOutput);
renderOutput();
</script>
