<script id="tool-logic">
/* ==== AI-GENERATED LOGIC — only this function's body is AI content ==== */
function processInput(text) {
if (!text || text.trim() === '') {
  return 'Please enter or paste some text to format.';
}

const trimmed = text.trim();

// Word and char counting
const charCount = text.length;
const wordCount = text.split(/\s+/).filter(Boolean).length;
const lineCount = text.split(/\n/).length;

// 1. Cleaned Text (Collapses multiple spaces, trims lines)
const clean = trimmed
  .replace(/[ \t]+/g, ' ')
  .replace(/\r/g, '')
  .replace(/\n\s*\n+/g, '\n\n');

// 2. UPPERCASE
const upper = trimmed.toUpperCase();

// 3. lowercase
const lower = trimmed.toLowerCase();

// 4. Title Case
const title = trimmed.replace(/\b\w+/g, (txt) => {
  return txt.charAt(0).toUpperCase() + txt.substring(1).toLowerCase();
});

// 5. Sentence Case
const sentence = trimmed.toLowerCase()
  .replace(/(^\s*|[.!?]\s+)([a-z])/g, (m, p1, p2) => p1 + p2.toUpperCase());

// 6. URL Slug
const slug = trimmed
  .toLowerCase()
  .replace(/[^a-z0-9\s-]/g, '')
  .replace(/\s+/g, '-')
  .replace(/-+/g, '-')
  .replace(/^-+|-+$/g, '');

// 7. camelCase
const camel = trimmed
  .replace(/[^a-zA-Z0-9\s-_]/g, '')
  .replace(/[-_]+/g, ' ')
  .toLowerCase()
  .replace(/(?:^\w|[A-Z]|\b\w)/g, (word, index) => {
    return index === 0 ? word.toLowerCase() : word.toUpperCase();
  })
  .replace(/\s+/g, '');

// 8. snake_case
const snake = trimmed
  .toLowerCase()
  .replace(/[^a-z0-9\s-_]/g, '')
  .replace(/[\s-_]+/g, '_')
  .replace(/^_+|_+$/g, '');

return `[ METRICS | Characters: ${charCount} | Words: ${wordCount} | Lines: ${lineCount} ]

=========================================
1. CLEANED TEXT (Single-spaced & Trimmed)
=========================================
${clean}

=========================================
2. TITLE CASE
=========================================
${title}

=========================================
3. SENTENCE CASE
=========================================
${sentence}

=========================================
4. UPPERCASE
=========================================
${upper}

=========================================
5. LOWERCASE
=========================================
${lower}

=========================================
6. URL SLUG
=========================================
${slug}

=========================================
7. CAMEL CASE
=========================================
${camel}

=========================================
8. SNAKE CASE
=========================================
${snake}`;
}
/* ==== END AI-GENERATED LOGIC ==== */

const toolInput = document.getElementById('toolInput');
const previewContainer = document.getElementById('previewContainer');
function renderOutput(text){
  let out;
  try { out = processInput(text); } catch(e){ out = ''; }
  previewContainer.innerHTML = (out && String(out).trim())
    ? `<div class="preview-item"><div class="preview-text">${String(out).replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div><button class="copy-btn" id="copyBtn">Copy</button></div>`
    : `<div style="text-align:center;padding:20px;color:var(--text-light)">Output will appear here</div>`;
  const copyBtn = document.getElementById('copyBtn');
  if(copyBtn) copyBtn.addEventListener('click', () => navigator.clipboard.writeText(String(out)));
}
document.getElementById('runBtn').addEventListener('click', () => renderOutput(toolInput.value));
document.getElementById('clearBtn').addEventListener('click', () => { toolInput.value=''; renderOutput(''); });
</script>
