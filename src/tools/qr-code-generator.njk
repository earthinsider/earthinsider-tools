<script id="tool-logic">
/* ==== AI-GENERATED LOGIC — only this function's body is AI content ==== */
function processInput(text) {
const trimmed = text.trim();
if (!trimmed) {
  return '<div style="color: #721c24; background-color: #f8d7da; border: 1px solid #f5c6cb; padding: 15px; border-radius: 4px; text-align: center;">Please enter a URL, email, phone number, or text in the input box above to generate your QR code.</div>';
}
const encodedData = encodeURIComponent(trimmed);
const qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=350x350&data=' + encodedData;
return '<div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; font-family: sans-serif;"><div style="background: white; padding: 15px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); display: inline-block;"><img src="' + qrUrl + '" alt="Generated QR Code" style="display: block; max-width: 100%; height: auto; width: 250px; height: 250px;" /></div><p style="margin: 15px 0 10px; color: #4a5568; font-size: 0.95rem; text-align: center;">Right-click the image to save, or click below to open.</p><div style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;"><a href="' + qrUrl + '" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; justify-content: center; padding: 10px 20px; background-color: #3182ce; color: white; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 0.9rem;">Open High-Res Image</a></div></div>';
}
/* ==== END AI-GENERATED LOGIC ==== */

const toolInput = document.getElementById('toolInput');
const previewContainer = document.getElementById('previewContainer');
function renderOutput(text){
  let out;
  try { out = processInput(text); } catch(e){ out = ''; }
  previewContainer.innerHTML = (out && String(out).trim())
    ? `<div class="preview-item"><div class="preview-text">${String(out).replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div><button class="copy-btn" id="copyBtn">Copy</button></div>`
    : `<div style="text-align:center;padding:20px;color:var(--text-light)">Output will appear here</div>`;
  const copyBtn = document.getElementById('copyBtn');
  if(copyBtn) copyBtn.addEventListener('click', () => navigator.clipboard.writeText(String(out)));
}
document.getElementById('runBtn').addEventListener('click', () => renderOutput(toolInput.value));
document.getElementById('clearBtn').addEventListener('click', () => { toolInput.value=''; renderOutput(''); });
</script>
