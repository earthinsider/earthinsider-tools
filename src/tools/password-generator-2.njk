<script id="tool-logic">
const fields = [{"id":"length","label":"Password Length (8 - 128)","type":"number"},{"id":"complexity","label":"Complexity Level (1: Low to 4: Ultra)","type":"number"}];

/* ==== AI-GENERATED LOGIC — only this function's body is AI content ==== */
function calculate(inputs) {
var len = parseInt(inputs.length, 10);
if (isNaN(len) || len < 4) len = 16;
if (len > 512) len = 512;

var comp = parseInt(inputs.complexity, 10);
if (isNaN(comp) || comp < 1) comp = 4;
if (comp > 4) comp = 4;

var lower = 'abcdefghijklmnopqrstuvwxyz';
var upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
var numbers = '0123456789';
var symbols = '!@#$%^&*()_+-=[]{}|;:,.<>?';

function getRandomInt(max) {
  if (typeof window !== 'undefined' && window.crypto && window.crypto.getRandomValues) {
    var arr = new Uint32Array(1);
    window.crypto.getRandomValues(arr);
    return arr[0] % max;
  }
  return Math.floor(Math.random() * max);
}

var pool = lower;
var mandatory = [];

mandatory.push(lower[getRandomInt(lower.length)]);

if (comp >= 2) {
  pool += upper;
  mandatory.push(upper[getRandomInt(upper.length)]);
}
if (comp >= 3) {
  pool += numbers;
  mandatory.push(numbers[getRandomInt(numbers.length)]);
}
if (comp >= 4) {
  pool += symbols;
  mandatory.push(symbols[getRandomInt(symbols.length)]);
}

var passArray = [];
for (var i = 0; i < len; i++) {
  passArray.push(pool[getRandomInt(pool.length)]);
}

for (var i = 0; i < mandatory.length; i++) {
  if (i < passArray.length) {
    passArray[i] = mandatory[i];
  }
}

for (var i = passArray.length - 1; i > 0; i--) {
  var j = getRandomInt(i + 1);
  var temp = passArray[i];
  passArray[i] = passArray[j];
  passArray[j] = temp;
}

return passArray.join('');
}
/* ==== END AI-GENERATED LOGIC ==== */

const fieldsContainer = document.getElementById('fieldsContainer');
fieldsContainer.innerHTML = fields.map(f => `
  <div style="margin-bottom:14px;">
    <label style="display:block;font-size:.85rem;margin-bottom:6px;color:var(--text-light);">${f.label}</label>
    <input class="input-text" style="min-height:auto;padding:10px 14px;" id="f_${f.id}" type="${f.type || 'text'}">
  </div>`).join('');

const previewContainer = document.getElementById('previewContainer');
document.getElementById('calcBtn').addEventListener('click', () => {
  const inputs = {};
  fields.forEach(f => { inputs[f.id] = document.getElementById('f_' + f.id).value; });
  let out;
  try { out = calculate(inputs); } catch(e){ out = 'Check your inputs.'; }
  previewContainer.innerHTML = `<div class="preview-item"><div class="preview-text">${String(out).replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div></div>`;
});
</script>
