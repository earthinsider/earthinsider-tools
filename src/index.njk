---
layout: layouts/base.njk
title: EarthInsider Tools — Free Browser-Based Text & Web Tools
description: A growing collection of fast, free tools that run entirely in your browser. No sign-up, nothing uploaded.
section: tools
schema:
  "@context": "https://schema.org"
  "@type": "WebSite"
  name: "EarthInsider Tools"
  url: "https://tools.earthinsider.in"
---
<section class="hero">
    <div class="container">
        <h1>EarthInsider Tools</h1>
        <p>Free, fast, browser-based tools. Nothing you type ever leaves your device.</p>
    </div>
</section>

<section class="recently-used" id="recentlyUsedSection" style="display:none;">
    <div class="container">
        <h2>Recently Used</h2>
        <div class="tools-grid" id="recentlyUsedGrid"></div>
    </div>
</section>

<section class="tools-section">
    <div class="container">
        <h2>Browse by Category</h2>
        <div class="category-grid">
            {% for cat in categories %}
            <a class="category-tile" href="/tools/category/{{ cat.slug }}/">
                <div class="category-icon">{{ cat.icon }}</div>
                <h3>{{ cat.name }}</h3>
                <p>{{ cat.description }}</p>
                <span class="category-count">{{ cat.slug | toolsByCategory | length }} tools</span>
            </a>
            {% endfor %}
            <a class="category-tile category-tile-all" href="/tools/all/">
                <div class="category-icon">🗂️</div>
                <h3>All Tools</h3>
                <p>Every tool on the site, in one list.</p>
                <span class="category-count">{{ collections.toolsList.length }} tools</span>
            </a>
        </div>
    </div>
</section>
