---
layout: layouts/base.njk
title: EarthInsider Tools — Free Browser-Based Web & Text Tools
description: A growing collection of fast, free tools that run entirely in your browser. No sign-up, nothing uploaded.
section: tools
---

<div class="recently-used" id="recentlyUsedSection">
  <h2>Recently Used</h2>
  <div class="recent-grid" id="recentlyUsedGrid"></div>
</div>

<section class="hero">
  <h1>EarthInsider<br><span class="accent">Tools</span></h1>
  <p class="hero-sub">Free, fast, browser-based utilities.<br>Nothing you type ever leaves your device.</p>
</section>

<section class="section">
  <h2>Browse by Category</h2>
  <div class="category-grid">
    {% for cat in categories %}
    <a class="category-tile" href="/tools/category/{{ cat.slug }}/">
      <div class="cat-icon-big">{{ cat.icon }}</div>
      <h3>{{ cat.name }}</h3>
      <p>{{ cat.description }}</p>
      <span class="cat-count">{{ cat.slug | toolsByCategory | length }} tools</span>
    </a>
    {% endfor %}
    <a class="category-tile cat-tile-all" href="/tools/all/">
      <div class="cat-icon-big">🗂️</div>
      <h3>All Tools</h3>
      <p>Every tool on the site, in one list.</p>
      <span class="cat-count">{{ collections.toolsList.length }} tools</span>
    </a>
  </div>
</section>
