---
layout: layouts/base.njk
pagination:
  data: categories
  size: 1
  alias: cat
permalink: "/tools/category/{{ cat.slug }}/"
section: tools
---
{% set title = cat.name %}
{% set description = cat.description %}
<section class="cat-hero">
  <div class="cat-icon-badge">{{ cat.icon }}</div>
  <h1>{{ cat.name }}</h1>
  <p>{{ cat.description }}</p>
</section>
<section class="tools-section">
  <div class="tools-grid">
    {% set catTools = cat.slug | toolsByCategory %}
    {% for item in catTools | withGridAdSlots %}
      {% if item.kind == "tool" %}
      <a class="tool-card" href="{{ item.tool.url }}">
        <div class="tool-icon">{{ item.tool | iconFor }}{% if item.tool.date | isNew %}<span class="new-badge">NEW</span>{% endif %}</div>
        <h3 class="tool-title">{{ item.tool.title }}</h3>
        <p class="tool-description">{{ item.tool.desc }}</p>
      </a>
      {% elif item.kind == "ad-mobile" %}
      <div class="ad-unit mobile">{% if site.mobileAdSlot %}{{ site.mobileAdSlot | safe }}{% endif %}</div>
      {% elif item.kind == "ad-desktop" %}
      <div class="ad-unit desktop tool-ad-desktop">{% if site.desktopAdSlot %}{{ site.desktopAdSlot | safe }}{% endif %}</div>
      {% endif %}
    {% endfor %}
    {% if catTools.length == 0 %}
    <p style="grid-column:1/-1;text-align:center;color:var(--on-surface-variant)">No tools in this category yet — check back soon.</p>
    {% endif %}
  </div>
</section>
