---
layout: layouts/base.njk
permalink: /tools/all/
title: All Tools — EarthInsider Tools
description: Every EarthInsider Tools utility in one list.
section: tools
---
<section class="hero" style="padding:20px 16px 16px">
  <h1 style="font-size:1.5rem">All Tools</h1>
</section>
<section class="tools-section">
  <div class="tools-grid">
    {% for item in collections.toolsList | withGridAdSlots %}
      {% if item.kind == "tool" %}
      <a class="tool-card" href="{{ item.tool.url }}">
        <div class="tool-icon-wrap">{{ item.tool | iconFor }}{% if item.tool.date | isNew %}<span class="new-badge">NEW</span>{% endif %}</div>
        <h3 class="tool-title">{{ item.tool.title }}</h3>
        <p class="tool-desc">{{ item.tool.desc }}</p>
      </a>
      {% elif item.kind == "ad-mobile" %}
      <div class="ad-unit mobile">{% if site.mobileAdSlot %}{{ site.mobileAdSlot | safe }}{% endif %}</div>
      {% elif item.kind == "ad-desktop" %}
      <div class="ad-unit desktop tool-ad-desktop">{% if site.desktopAdSlot %}{{ site.desktopAdSlot | safe }}{% endif %}</div>
      {% endif %}
    {% endfor %}
  </div>
</section>
