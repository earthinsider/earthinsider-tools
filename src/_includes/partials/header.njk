{% from "partials/icons.njk" import globe, search, moon, sun, menu %}
<!-- ==== HEADER (global component #1) ==== -->
<header class="site-header">
  <div class="header-row">
    <a href="/" class="logo">
      <div class="logo-mark">
        {% if site.logoUrl %}<img class="logo-img" src="{{ site.logoUrl }}" alt="{{ site.siteName }}" loading="lazy">
        {% else %}{{ globe() }}{% endif %}
      </div>
      <span class="logo-text">EarthInsider <span class="logo-tag">Tools</span></span>
    </a>

    <nav class="desktop-nav">
      <a href="/tools/" class="{{ 'active' if section == 'tools' }}">Tools</a>
      <a href="/pages/" class="{{ 'active' if section == 'pages' }}">Pages</a>
    </nav>

    <div class="desktop-search">
      {{ search() }}
      <input id="desktopSearchInput" type="text" placeholder="Search tools & pages… ( / )">
      <div id="desktopSearchResults" class="search-results" style="position:absolute;top:calc(100% + 8px);left:0;right:0;background:var(--surface-low);border:1px solid var(--outline-variant);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.4);max-height:320px;overflow:auto;display:none;z-index:200"></div>
    </div>

    <div class="header-actions">
      <div class="desktop-badge"><span class="status-dot"></span> 100% Client-Side</div>
      <button class="icon-btn" id="themeToggle" aria-label="Toggle dark/light mode">{{ moon() }}{{ sun() }}</button>
      <button class="icon-btn" id="mobileMenuBtn" aria-label="Open menu">{{ menu() }}</button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenuPanel">
    <div class="mobile-search">
      {{ search() }}
      <input id="searchInput" type="text" placeholder="Search tools & pages…">
      <div id="searchResults" class="search-results" style="position:absolute;top:100%;left:12px;right:12px;background:var(--surface-low);border:1px solid var(--outline-variant);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.4);max-height:260px;overflow:auto;display:none;z-index:200"></div>
    </div>
    <a href="/tools/">Tools</a>
    <a href="/pages/">Pages</a>
  </div>
</header>

<!-- Ad slots: header position -->
<div style="position:relative">
  <div class="ad-unit desktop">{% if site.desktopAdSlot %}{{ site.desktopAdSlot | safe }}{% else %}<!-- Desktop Ad Slot: header -->{% endif %}</div>
  <div class="ad-unit mobile">{% if site.mobileAdSlot %}{{ site.mobileAdSlot | safe }}{% else %}<!-- Mobile Ad Slot: header -->{% endif %}</div>
</div>
