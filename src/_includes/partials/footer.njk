{% from "partials/icons.njk" import home, grid, bolt, shield %}
<!-- ==== FOOTER (global component #2) ==== -->
<footer>
  <div class="footer-brand">
    <h3>{{ site.siteName }}</h3>
    <p>100% Client-Side. No data ever leaves your device.</p>
  </div>
  <div class="footer-content">
    <div class="footer-section">
      <h4>Tools</h4>
      {% for t in collections.toolsList %}
      <a href="{{ t.url }}">{{ t.title }}</a>
      {% endfor %}
    </div>
    <div class="footer-section">
      <h4>Pages</h4>
      {% for p in collections.pagesList %}
      <a href="{{ p.url }}">{{ p.title }}</a>
      {% endfor %}
    </div>
  </div>

  <!-- Footer ad slots -->
  <div class="ad-unit desktop" style="margin:16px 0 8px">{% if site.desktopAdSlot %}{{ site.desktopAdSlot | safe }}{% else %}<!-- Desktop Ad Slot: footer -->{% endif %}</div>
  <div class="ad-unit mobile" style="margin:16px 0 8px">{% if site.mobileAdSlot %}{{ site.mobileAdSlot | safe }}{% else %}<!-- Mobile Ad Slot: footer -->{% endif %}</div>

  <div class="copyright">© {{ currentYear }} {{ site.siteName }}. All rights reserved.</div>
</footer>

<!-- Bottom nav (mobile only) -->
<nav class="bottom-nav">
  <div class="bottom-nav-row">
    <a href="/">{{ home() }}Suites</a>
    <a href="/tools/all/">{{ grid() }}All Tools</a>
    <a href="/tools/">{{ bolt() }}Browse</a>
    <a href="/pages/privacy/">{{ shield() }}Privacy</a>
  </div>
</nav>
