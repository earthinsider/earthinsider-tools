---
layout: layouts/base.njk
title: Search
description: Search EarthInsider Tools.
section: tools
noindex: true
---
<div class="search-head">
  <h1>Results for "<span class="search-q" id="queryText"></span>"</h1>
  <div class="results-count" id="rCount"></div>
</div>
<div class="filter-row sf">
  <button class="filter-btn active" data-f="all">All</button>
  <button class="filter-btn" data-f="tool">Tools</button>
  <button class="filter-btn" data-f="page">Pages</button>
</div>
<div class="results-grid" id="rGrid" style="margin-top:12px"></div>
<div class="empty-state" id="rEmpty"><h2>No matches found</h2><p>Try different words, or browse by category.</p><a href="/tools/">Browse Tools</a></div>
<script>
(function(){
  var q=(new URLSearchParams(window.location.search).get('q')||'').trim();
  var qEl=document.getElementById('queryText');
  var grid=document.getElementById('rGrid');
  var empty=document.getElementById('rEmpty');
  var cnt=document.getElementById('rCount');
  if(qEl) qEl.textContent=q;
  fetch('/search-index.json').then(function(r){return r.json();}).then(function(data){
    var m=q?data.filter(function(t){return t.title.toLowerCase().includes(q.toLowerCase());}):data;
    cnt.textContent=m.length+' result'+(m.length!==1?'s':'');
    grid.innerHTML=m.map(function(t){
      return '<a class="result-card" href="'+t.url+'">'
        +'<div class="result-icon">'+(t.icon||t.title.charAt(0))+'</div>'
        +'<div class="result-body"><div class="result-top"><span class="type-tag '+t.type+'">'+t.type+'</span></div>'
        +'<h3>'+t.title+'</h3><p>'+t.desc+'</p></div></a>';
    }).join('');
    if(!m.length){grid.style.display='none';empty.classList.add('show');}
  });
  document.querySelectorAll('.filter-btn').forEach(function(b){
    b.addEventListener('click',function(){
      document.querySelectorAll('.filter-btn').forEach(function(x){x.classList.remove('active');});
      b.classList.add('active');
      var f=b.getAttribute('data-f');
      var cards=document.querySelectorAll('.result-card');
      var n=0;
      cards.forEach(function(c){
        var show=f==='all'||c.querySelector('.type-tag').textContent===f;
        c.style.display=show?'':'none';
        if(show)n++;
      });
      cnt.textContent=n+' result'+(n!==1?'s':'');
      empty.classList.toggle('show',n===0);
    });
  });
})();
</script>
