---
layout: layouts/base.njk
permalink: /tools/{{ slug }}/
title: {{ ai_title }}
description: {{ ai_description }}
section: tools
schema:
  "@context": "https://schema.org"
  "@type": "SoftwareApplication"
  name: "{{ ai_title }}"
  applicationCategory: "UtilitiesApplication"
  operatingSystem: "Any (runs in browser)"
advertisementsInnerCodes: []
---
{% include "partials/breadcrumbs.njk" %}
<section class="hero"><h1>{{ ai_title }}</h1><p class="hero-subtitle">{{ ai_description }}</p></section>
<div style="display:flex;flex-direction:column">
  <section class="tool-widget" style="padding:0 16px 16px">
    <div class="workstation">
      <div class="action-col"><button class="btn-primary" id="genBtn" type="button">Generate</button></div>
      <div class="panel" style="margin-top:12px"><div class="panel-head"><span class="panel-title">Output</span><button class="panel-btn" id="copyBtn" type="button">Copy</button></div><div class="output-text" id="outputText">Click Generate</div></div>
    </div>
    <button class="share-btn" type="button">🔗 Share this tool</button>
  </section>
  <section class="seo-content"><div class="info-section"><h2>{{ ai_seo_heading }}</h2>{% set _ads = advertisementsInnerCodes if advertisementsInnerCodes.length else site.defaultAdvertisementsInnerCodes %}{{ ai_seo_content_html | safe | spreadInnerAds(_ads) | safe }}</div></section>
</div>
{% include "partials/related-tools.njk" %}
<script id="tool-logic">
function generate() {
{{ ai_js_code }}
}
var output=document.getElementById('outputText');
function run(){var out;try{out=generate();}catch(e){out='';}output.textContent=out&&String(out).trim()?out:'Click Generate';}
document.getElementById('genBtn').addEventListener('click',run);
document.getElementById('copyBtn').addEventListener('click',function(){window.EI_copyText&&window.EI_copyText(output.textContent,this);});
document.querySelector('.share-btn').addEventListener('click',function(){window.EI_copyText&&window.EI_copyText(window.location.href,this);});
run();
</script>
