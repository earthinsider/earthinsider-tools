---
layout: layouts/base.njk
permalink: /tools/{{ slug }}/
title: {{ ai_title }}
description: {{ ai_description }}
section: tools
schema:
  "@context": "https://schema.org"
  "@type": "SoftwareApplication"
  name: "{{ ai_title }}"
  applicationCategory: "UtilitiesApplication"
  operatingSystem: "Any (runs in browser)"
advertisementsInnerCodes: []
---
{#
  SHELL: text-io
  JS CONTRACT the AI must fill in (see <script id="tool-logic"> below):
    function processInput(text) { ... ; return outputString; }
  Nothing else about this file should be touched by the generator —
  only the {{ ai_* }} tokens and the processInput body.
#}
<section class="hero"><div class="container"><h1>{{ ai_title }}</h1></div></section>
<p class="hero-subtitle">{{ ai_description }}</p>

<div class="container stack">
    <section class="tool-widget">
        <div class="app-container">
            <section class="input-section">
                <h2 class="section-title">Input</h2>
                <textarea class="input-text" id="toolInput" placeholder="Type or paste text here..."></textarea>
                <div class="button-group">
                    <button class="encode-btn" id="runBtn">{{ ai_action_label | default("Run") }}</button>
                    <button class="clear-btn" id="clearBtn">Clear</button>
                </div>
            </section>
            <section class="preview-section">
                <h2 class="section-title">Output</h2>
                <div id="previewContainer"></div>
            </section>
        </div>
    </section>

    <section class="seo-content">
        <div class="info-section">
            <div class="container">
                <h2>{{ ai_seo_heading }}</h2>
                <div class="info-content">
                    {{ ai_seo_content_html | safe | spreadInnerAds(advertisementsInnerCodes.length and advertisementsInnerCodes or site.defaultAdvertisementsInnerCodes) }}
                </div>
            </div>
        </div>
    </section>
</div>

<script id="tool-logic">
/* ==== AI-GENERATED LOGIC — only this function's body is AI content ==== */
function processInput(text) {
{{ ai_js_code }}
}
/* ==== END AI-GENERATED LOGIC ==== */

const toolInput = document.getElementById('toolInput');
const previewContainer = document.getElementById('previewContainer');
function renderOutput(text){
  let out;
  try { out = processInput(text); } catch(e){ out = ''; }
  previewContainer.innerHTML = (out && String(out).trim())
    ? `<div class="preview-item"><div class="preview-text">${String(out).replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div><button class="copy-btn" id="copyBtn">Copy</button></div>`
    : `<div style="text-align:center;padding:20px;color:var(--text-light)">Output will appear here</div>`;
  const copyBtn = document.getElementById('copyBtn');
  if(copyBtn) copyBtn.addEventListener('click', () => navigator.clipboard.writeText(String(out)));
}
document.getElementById('runBtn').addEventListener('click', () => renderOutput(toolInput.value));
document.getElementById('clearBtn').addEventListener('click', () => { toolInput.value=''; renderOutput(''); });
</script>
