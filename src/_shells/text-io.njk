---
layout: layouts/base.njk
permalink: /tools/{{ slug }}/
title: {{ ai_title }}
description: {{ ai_description }}
section: tools
schema:
  "@context": "https://schema.org"
  "@type": "SoftwareApplication"
  name: "{{ ai_title }}"
  applicationCategory: "UtilitiesApplication"
  operatingSystem: "Any (runs in browser)"
advertisementsInnerCodes: []
---
{% include "partials/breadcrumbs.njk" %}
<section class="hero"><h1>{{ ai_title }}</h1><p class="hero-subtitle">{{ ai_description }}</p></section>
<div style="display:flex;flex-direction:column">
  <section class="tool-widget" style="padding:0 16px 16px">
    <div class="workstation">
      <div class="panels">
        <div class="panel"><div class="panel-head"><span class="panel-title">Input</span><span class="counter-pill" id="inputCounter">0 chars</span></div><textarea class="tool-input" id="toolInput" placeholder="Type or paste text here..."></textarea></div>
        <div class="action-col"><button class="btn-primary" id="runBtn" type="button">{{ ai_action_label | default("Run") }}</button><button class="btn-secondary" id="clearBtn" type="button">Clear</button></div>
        <div class="panel"><div class="panel-head"><span class="panel-title">Output</span><button class="panel-btn" id="copyBtn" type="button">Copy</button></div><div class="output-text" id="outputText">Output will appear here</div></div>
      </div>
    </div>
    <button class="share-btn" type="button">🔗 Share this tool</button>
  </section>
  <section class="seo-content"><div class="info-section"><h2>{{ ai_seo_heading }}</h2><div id="seoBody">{% set _ads = advertisementsInnerCodes if advertisementsInnerCodes.length else site.defaultAdvertisementsInnerCodes %}{{ ai_seo_content_html | safe | spreadInnerAds(_ads) | safe }}</div></div></section>
</div>
{% include "partials/related-tools.njk" %}
<script id="tool-logic">
function processInput(text) {
{{ ai_js_code }}
}
var input=document.getElementById('toolInput'),output=document.getElementById('outputText'),counter=document.getElementById('inputCounter');
function run(){var t=input.value,out;try{out=processInput(t);}catch(e){out='';}output.textContent=out&&String(out).trim()?out:'Output will appear here';}
document.getElementById('runBtn').addEventListener('click',run);
document.getElementById('clearBtn').addEventListener('click',function(){input.value='';counter.textContent='0 chars';output.textContent='Output will appear here';});
document.getElementById('copyBtn').addEventListener('click',function(){window.EI_copyText&&window.EI_copyText(output.textContent,this);});
input.addEventListener('input',function(){counter.textContent=input.value.length+' chars';run();});
document.addEventListener('keydown',function(e){if((e.ctrlKey||e.metaKey)&&e.key==='Enter'){e.preventDefault();run();}});
document.querySelector('.share-btn').addEventListener('click',function(){window.EI_copyText&&window.EI_copyText(window.location.href,this);});
</script>
